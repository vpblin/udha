# Udha relay configuration.
#
#   cp .env.example .env && $EDITOR .env && docker compose up -d
#
# Only AUTH0_DOMAIN and AUTH0_AUDIENCE are required. Everything else has a
# working default; the relay prints what it resolved at startup, and refuses
# to start — naming the variable — if something required is missing.


# ---------------------------------------------------------------------------
# Auth (required)
# ---------------------------------------------------------------------------

# auth0        — verify every connection's access token against your tenant.
#                This is the only mode you should ever expose to a network.
# insecure-dev — accept ANY token and use it as the account id. For localhost
#                testing and the test suite only. Anyone who can reach the port
#                gets full control of every connected machine.
AUTH_MODE=auth0

# Your Auth0 tenant, without a scheme. Auth0 Dashboard → Settings → Domain.
# Required unless AUTH_MODE=insecure-dev.
AUTH0_DOMAIN=your-tenant.us.auth0.com

# The Identifier of the Auth0 API you created for this relay (Applications →
# APIs → your API → Identifier). It does not have to resolve to anything; it
# just has to match what the apps send as `audience`.
# Required unless AUTH_MODE=insecure-dev.
AUTH0_AUDIENCE=https://relay.example.com

# Expected `iss` claim. Defaults to https://<AUTH0_DOMAIN>/ — set this only if
# you use an Auth0 custom domain and the tokens are issued under it.
# AUTH0_ISSUER=https://login.example.com/

# Where the signing keys are fetched from. Defaults to
# https://<AUTH0_DOMAIN>/.well-known/jwks.json
# AUTH0_JWKS_URI=https://login.example.com/.well-known/jwks.json

# An access token carries no `email` claim unless an Auth0 Action adds a
# namespaced one. Name it here to get readable log lines instead of a
# truncated user id. Purely cosmetic — leave it unset if you did not add one.
# AUTH0_EMAIL_CLAIM=https://relay.example.com/email

# Cap on JWKS fetches per minute (the keys are cached for an hour anyway).
# JWKS_REQUESTS_PER_MINUTE=10


# ---------------------------------------------------------------------------
# Network
# ---------------------------------------------------------------------------

# Port the Node process listens on. Inside the container this stays 8080 and
# you change PUBLISH_PORT below instead.
PORT=8080

# Interface to bind. 0.0.0.0 in a container; 127.0.0.1 when a reverse proxy on
# the same host is the only thing that should reach it.
BIND_ADDRESS=0.0.0.0

# docker-compose only: where the container's 8080 is published on the host.
# Use PUBLISH_ADDRESS=127.0.0.1 when Caddy/nginx on this host fronts the relay.
PUBLISH_ADDRESS=0.0.0.0
PUBLISH_PORT=8080

# The public wss:// URL, used only for the endpoint lines printed at startup —
# so the log tells you the URL to paste into the apps. No behaviour depends on
# it. Defaults to ws://localhost:<PORT>.
# PUBLIC_URL=wss://relay.example.com


# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------

# Directory holding paired-instances.json — which machines each account has
# paired. Mounted as a volume by docker-compose. Created if missing.
# DATA_DIR=/data


# ---------------------------------------------------------------------------
# Timing and limits (defaults are fine)
# ---------------------------------------------------------------------------

# WebSocket keepalive. A peer that misses one ping round is terminated, which
# is what makes an instance_offline fire for a machine that lost power.
# PING_INTERVAL_MS=30000

# How long a pair_request waits for the host to answer validate_pairing.
# PAIRING_TIMEOUT_MS=30000

# How long a phone's "I am looking at this session" presence suppresses a push
# for that session. Presence is refreshed by the app while it is foregrounded.
# ATTENTION_PRESENCE_TTL_MS=45000

# Per-IP connection-attempt limit, counted on the HTTP upgrade.
# RATE_LIMIT_MAX_ATTEMPTS=10
# RATE_LIMIT_WINDOW_MS=60000


# ---------------------------------------------------------------------------
# Apple push notifications (optional — iOS app only)
# ---------------------------------------------------------------------------
#
# This is how a backgrounded iPhone/iPad hears that a session is waiting on a
# human. The desktop and udha-agent never receive pushes, so you can leave the
# whole block unset: the relay logs "Push notifications disabled" and every
# other feature works.
#
# Set ALL of APNS_KEY_ID, APNS_TEAM_ID, APNS_BUNDLE_ID and one of
# APNS_KEY_PATH / APNS_KEY, or push stays off (the relay says which are
# missing). Values come from the Apple Developer portal:
#   Certificates, Identifiers & Profiles → Keys → a key with APNs enabled.

# The 10-character Key ID of that APNs auth key.
# APNS_KEY_ID=ABCD123456

# Your 10-character Apple Developer Team ID (Membership details).
# APNS_TEAM_ID=ABCD123456

# The bundle identifier of YOUR build of the iOS app — this is the APNs topic,
# and it must match the app that registered the device token.
# APNS_BUNDLE_ID=com.example.udha

# Path to the .p8 signing key inside the container. docker-compose has a
# commented-out read-only mount for exactly this.
# APNS_KEY_PATH=/run/secrets/apns.p8

# Alternative to APNS_KEY_PATH: the PEM contents inline, with literal \n for
# newlines. Handy for a secret store; do not commit it.
# APNS_KEY=-----BEGIN PRIVATE KEY-----\nMIGT...\n-----END PRIVATE KEY-----

# false → api.sandbox.push.apple.com (a development build installed from Xcode)
# true  → api.push.apple.com (TestFlight or App Store build)
# A token minted by one environment is rejected by the other, which is the
# usual reason pushes silently never arrive.
# APNS_PRODUCTION=false

# How long APNs should keep trying to deliver, in seconds.
# APNS_EXPIRATION_SECONDS=300
